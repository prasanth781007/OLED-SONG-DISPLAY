rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any logged-in account (website user OR ESP32 device) can READ.
    // Only the ADMIN (website) account can WRITE.
    // >>> Replace with the email you use to log in on the website <<<
    match /{document=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'YOUR_ADMIN_EMAIL@gmail.com';
    }
  }
}
